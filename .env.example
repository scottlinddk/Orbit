# Copy to .env and adjust. Never commit .env. See apps/api/README.md for details.
#
# Which file is read depends on how you run Orbit:
#   Docker (Compose): Compose reads .env next to compose.yaml, but passes only the variables
#                     listed in section 1 into the container. The image fixes ORBIT_HOST,
#                     ORBIT_PORT, ORBIT_DATABASE_PATH and ORBIT_WEB_DIR, so setting those in
#                     .env does nothing under Docker.
#   Node (no Docker): the API does not load .env itself. Start it with
#                     `node --env-file=.env apps/api/src/main.ts`, or export the variables.
#                     It reads everything in section 2, and section 1 too except the
#                     ORBIT_HOST_PORT and ORBIT_DOMAIN lines.

# --- 1. Docker (Compose) and Node: applies to both ---------------------------------------
# The address people type in the browser. Use https:// in production.
# Docker default follows ORBIT_HOST_PORT; Node default is http://localhost:3000.
# ORBIT_PUBLIC_URL=http://localhost:3000
# first-user-only | open
ORBIT_REGISTRATION=first-user-only
# Optional. Your own code for creating the first account (12 to 64 characters), instead of the
# random one printed in the server log at start. Use a secret value, and remove it after setup.
# ORBIT_SETUP_CODE=
# Only true behind a reverse proxy you control.
ORBIT_TRUST_PROXY=false
ORBIT_LOG_LEVEL=info
# Snapshots kept in <data folder>/backups before each schema upgrade.
# ORBIT_MIGRATION_SNAPSHOTS=5
# Automatic backups in <data folder>/backups: hours between them (0 turns them off) and how many to keep.
# ORBIT_BACKUP_INTERVAL_HOURS=24
# ORBIT_BACKUP_KEEP=14

# --- Docker only -----------------------------------------------------------------------
# The port published on this machine, and the domain for the Caddy override.
# ORBIT_HOST_PORT=3000
# ORBIT_DOMAIN=orbit.example.com

# --- 2. Node without Docker only (ignored by the image) --------------------------------
ORBIT_DATABASE_PATH=./data/orbit.sqlite
ORBIT_HOST=127.0.0.1
ORBIT_PORT=3000
# Serve the built web app from the API (the image sets this itself).
# ORBIT_WEB_DIR=./apps/web/dist
