{
  "openapi": "3.0.3",
  "info": {
    "title": "Orbit API",
    "version": "0.0.0",
    "description": "Authentication is a session cookie set by POST /auth/login (named orbit_session, or __Host-orbit_session over HTTPS). Errors use RFC 9457 problem details. A resource in a household you do not belong to is reported as 404, never 403."
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "orbit_session"
      }
    },
    "schemas": {
      "UserInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName"
        ]
      },
      "ProblemInput": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "DashboardInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "householdId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "columns": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  1
                ]
              },
              {
                "type": "number",
                "enum": [
                  2
                ]
              },
              {
                "type": "number",
                "enum": [
                  3
                ]
              },
              {
                "type": "number",
                "enum": [
                  4
                ]
              }
            ]
          },
          "widgets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "span": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "config": {
                  "type": "object",
                  "additionalProperties": {}
                }
              },
              "required": [
                "id",
                "type",
                "span",
                "config"
              ]
            }
          }
        },
        "required": [
          "id",
          "householdId",
          "name",
          "columns",
          "widgets"
        ]
      },
      "HouseholdInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "owner",
                    "member"
                  ]
                }
              },
              "required": [
                "userId",
                "role"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "members"
        ]
      },
      "User": {
        "type": "object",
