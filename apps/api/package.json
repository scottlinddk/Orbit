    "@orbit/adapter-egress-guard": "workspace:*",
    "@orbit/adapter-identity-local": "workspace:*",
    "@orbit/adapter-jobs-sqlite": "workspace:*",
    "@orbit/adapter-oidc": "workspace:*",
    "@orbit/adapter-persistence-sqlite": "workspace:*",
    "@orbit/adapter-planets-sqlite": "workspace:*",
    "@orbit/adapter-secrets-encrypted-db": "workspace:*",
    "@orbit/application": "workspace:*",
    "@orbit/contracts": "workspace:*",
    "@orbit/domain": "workspace:*",
    "@orbit/integration-home-assistant": "workspace:*",
    "@orbit/integration-ics-calendar": "workspace:*",
    "@orbit/module-planets": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
