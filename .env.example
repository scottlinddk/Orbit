# Copy to .env and adjust. Never commit .env. See apps/api/README.md for details.
# The API reads real environment variables and does not load .env itself;
# use `node --env-file=.env apps/api/src/main.ts` or your container's env settings.

ORBIT_DATABASE_PATH=./data/orbit.sqlite
ORBIT_HOST=127.0.0.1
ORBIT_PORT=3000
# The address people type in the browser. Use https:// in production.
ORBIT_PUBLIC_URL=http://localhost:3000
# first-user-only | open
ORBIT_REGISTRATION=first-user-only
# Only true behind a reverse proxy you control.
ORBIT_TRUST_PROXY=false
ORBIT_LOG_LEVEL=info
